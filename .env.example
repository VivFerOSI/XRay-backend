# === Base de datos (PostgreSQL / Google Cloud SQL) ===
# En local: apuntá a tu Postgres. En Cloud Run: usar el socket de Cloud SQL
# (DB_HOST=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE>) y gestionar la
# contraseña con Secret Manager (ver GCP_DEPLOY.md, sección 5).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=xray
# Poné 'true' SOLO en desarrollo. En producción usar migraciones.
DB_SYNCHRONIZE=false

# === Envío de emails (Brevo) ===
# Sin esta key el backend NO envía correos: loguea un warning y sigue.
# Se saca de Brevo: SMTP & API > API Keys.
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders). Debe ser EXACTAMENTE la casilla
# verificada, o Brevo rechaza el envío.
MAIL_FROM=servicios1@x-ray.ar
MAIL_FROM_NAME=X-Ray
# Casilla interna que recibe el aviso de cada lead nuevo del Stress Test.
LEADS_NOTIFICATION_EMAIL=servicios1@x-ray.ar

# Base publica del frontend: se usa para el enlace al informe que va en los
# correos (/autoevaluacion/resultado/<id>). En local: http://localhost:5173
PUBLIC_APP_URL=https://x-ray.ar

# === Frontend permitido para CORS ===
FRONTEND_ORIGIN=http://localhost:5173

# Puerto del servidor (Cloud Run inyecta PORT=8080)
PORT=3000
